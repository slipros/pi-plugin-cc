{
  "trustProjectConfig": true,
  "defaults": {
    "model": "vllm/Qwen3.8-27B",
    "thinking": "off",
    "timeoutMs": 10800000
  },
  "cacheTtl": {
    "default": "40m",
    "providers": {
      "vllm": "24h",
      "zai-coding-cn": "12h",
      "zai-flash": "12h",
      "opencode-go": "12h",
      "deepseek": "12h"
    }
  },
  "gitProxy": {
    "gitlab.example.com": {
      "user": "oauth2",
      "tokenCommand": "echo GIT_TOKEN=$MY_GIT_TOKEN"
    },
    "10.0.0.1": {
      "user": "oauth2",
      "tokenCommand": "echo GIT_TOKEN=$MY_SELFHOSTED_TOKEN"
    }
  },
  "sandboxServices": [
    {
      "id": "agent-base",
      "image": "pi-sandbox-agent:latest",
      "dockerfile": "agent",
      "mounts": [
        "~/.claude/pi/bin/linux:/pi-gobin:ro",
        "~/DevProjects/go/bin:/gobin:ro",
        "~/DevProjects/go/pkg/mod/cache/download:/host-gomod:ro",
        "~/.pi/agent/extensions:/pi-agent/host-extensions:ro",
        "pi-plugin-agent-gomod:/home/pi/go/pkg/mod",
        "pi-plugin-agent-cache:/home/pi/.cache",
        "pi-plugin-agent-cargo:/usr/local/cargo/registry",
        "pi-plugin-agent-npm:/home/pi/.npm",
        "pi-plugin-agent-pnpm:/home/pi/.local/share/pnpm",
        "~/.pi/agent/lsp.agent.json:/home/pi/.pi/agent/lsp.json:ro",
        "~/.pi/agent/lsp.agent.lock.json:/home/pi/.pi/agent/lsp/lsp.lock.json:ro",
        "~/.claude/pi/githooks:/pi-githooks:ro",
        "~/.pi/agent/skills/vision:/pi-skills/vision:ro"
      ],
      "env": [
        "PATH=/pi-skills/vision/scripts:/usr/local/cargo/bin:/usr/local/go/bin:/pi-gobin:/gobin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "GOPROXY=file:///host-gomod,https://proxy.golang.org,direct",
        "GOPRIVATE=gitlab.gid.team,157.22.252.213,github.com,gitlab.loc",
        "GOFLAGS=-mod=mod",
        "GIT_TERMINAL_PROMPT=0",
        "CARGO_TERM_COLOR=never",
        "NPM_CONFIG_FUND=false",
        "NPM_CONFIG_AUDIT=false",
        "OMP_NUM_THREADS=4",
        "OPENBLAS_NUM_THREADS=4",
        "MKL_NUM_THREADS=4",
        "NUMEXPR_NUM_THREADS=4",
        "GIT_CONFIG_COUNT=2",
        "GIT_CONFIG_KEY_0=core.hooksPath",
        "GIT_CONFIG_VALUE_0=/pi-githooks",
        "GIT_CONFIG_KEY_1=commit.gpgsign",
        "GIT_CONFIG_VALUE_1=false"
      ],
      "extensions": [
        "/pi-agent/host-extensions/hooks/index.ts",
        "/usr/local/lib/node_modules/pi-lsp-adapter/src/index.ts"
      ],
      "args": [
        "--cpus",
        "6"
      ],
      "skills": [
        "/pi-skills/vision"
      ]
    },
    {
      "id": "agent",
      "extend": "agent-base",
      "env": [
        "PI_DIND=1",
        "DOCKERD_ROOTLESS_ROOTLESSKIT_FLAGS=--pidns",
        "TESTCONTAINERS_RYUK_DISABLED=true",
        "TESTCONTAINERS_HOST_OVERRIDE=127.0.0.1",
        "PI_REGISTRY_MIRROR=http://host.docker.internal:5000"
      ],
      "mounts": [
        "pi-dind-agent-images:/home/pi/.local/share/docker:isolate"
      ],
      "args": [
        "--security-opt",
        "seccomp=@sandbox/dind-seccomp.json",
        "--security-opt",
        "systempaths=unconfined",
        "--device",
        "/dev/net/tun",
        "--add-host",
        "host.docker.internal:host-gateway"
      ]
    },
    {
      "id": "agent-lite",
      "extend": "agent-base"
    }
